<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent, DIFF test plugin: SNAPSHOT image diffs and ASSERT_LAYOUT
     checks for MonkeyTester (:8095). Replace CHECKOUT_DIR and PYTHON (any
     python3 >= 3.10; standard library only), copy to ~/Library/LaunchAgents/,
     then:
     launchctl load ~/Library/LaunchAgents/com.blackjackfruit.monkeytester-diff.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blackjackfruit.monkeytester-diff</string>
  <key>ProgramArguments</key>
  <array>
    <string>PYTHON</string>
    <string>CHECKOUT_DIR/diff_plugin.py</string>
  </array>
  <key>WorkingDirectory</key><string>CHECKOUT_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PLUGIN_PORT</key><string>8095</string>
    <!-- The API listens on 127.0.0.1 by default. For LAN access set BOTH
         PLUGIN_BIND and PLUGIN_TOKEN (>= 16 chars, e.g. `openssl rand -hex 32`);
         without the token the plugin refuses to start. See SECURITY.md.
    <key>PLUGIN_BIND</key><string>0.0.0.0</string>
    <key>PLUGIN_TOKEN</key><string>TOKEN</string>
    -->
    <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/monkeytester-diff.log</string>
  <key>StandardErrorPath</key><string>/tmp/monkeytester-diff.log</string>
</dict>
</plist>
